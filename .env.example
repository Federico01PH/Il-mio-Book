# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin / Auth ---
# Email a cui arrivano le richieste di accesso
ADMIN_EMAIL=fedephazza@gmail.com
# Stringa lunga e casuale (almeno 32 caratteri). Usata per:
#  1. firmare HMAC dei link admin in email
#  2. password per il login alla dashboard /admin/login
ADMIN_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale

# --- Email (Resend) ---
# Crea un account su resend.com, ottieni la API key
MAILER_API_KEY=re_xxx
# Mittente verificato su Resend (es. "Portfolio <noreply@tuodominio.com>")
MAILER_FROM=Portfolio <noreply@tuodominio.com>

# --- Telegram (opzionale ma consigliato) ---
# Crea un bot con @BotFather su Telegram, ottieni il token
TELEGRAM_BOT_TOKEN=1234567890:AAF...
# Manda un messaggio al bot, poi apri: https://api.telegram.org/bot<TOKEN>/getUpdates
# Trovi il tuo chat_id nel campo "from.id"
TELEGRAM_CHAT_ID=123456789

# --- Sito ---
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Portfolio
